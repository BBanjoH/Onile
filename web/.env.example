# SQLite for local dev (default, zero setup). For production, use a
# managed Postgres URL and change the provider in prisma/schema.prisma
# to "postgresql".
DATABASE_URL="file:./dev.db"

# Long random string used to sign session JWTs. Generate with:
#   openssl rand -base64 48
JWT_SECRET="replace-this-with-a-long-random-secret"

# Base URL of the deployed app (used for absolute links, e.g. in PWA metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
