# Onile runs on Postgres. Both of these come from one place in Supabase:
# open your project, click "Connect" at the top, and choose the "ORMs" tab.
# It shows you both lines, already filled in — copy them here.
#
#   DATABASE_URL — the pooled connection (port 6543), used by the website
#   DIRECT_URL   — the direct connection (port 5432), used only when
#                  applying database updates during a deploy
#
# Remember to replace [YOUR-PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Long random string used to sign session JWTs. Generate with:
#   openssl rand -base64 48
JWT_SECRET="replace-this-with-a-long-random-secret"

# Base URL of the deployed app (used for absolute links, payment redirects,
# and the sitemap). Must be your real web address in production, with no
# trailing slash — e.g. "https://onile.ng".
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Who your users reach when they tap "Get help". The phone number is used
# for both the WhatsApp button and the call button, so use a number that has
# WhatsApp on it. Set these before launch — otherwise the Help page tells
# people support isn't set up yet.
NEXT_PUBLIC_SUPPORT_PHONE="2348012345678"
NEXT_PUBLIC_SUPPORT_EMAIL="help@onile.ng"
# The legal name shown on your Terms and Privacy pages.
NEXT_PUBLIC_COMPANY_NAME="Onile Technologies Ltd"

# Your own email address. The account using this email becomes an
# administrator (able to approve ownership documents and handle reports of
# fake landlords) as soon as it signs up or next logs in — so you can set
# yourself up without running any commands. There is no other way to become
# an admin through the website. Leave it empty to switch this off.
BOOTSTRAP_ADMIN_EMAIL=""

# Optional shared secret for GET /api/cron/rent-automation (rent-schedule
# generation + overdue flagging). Set this and pass it as ?secret=... or an
# x-cron-secret header when wiring the route to a scheduler (Vercel Cron,
# a GitHub Actions cron job, etc). Leave unset in dev — the dashboard/tenant
# pages already run the same logic on every page load.
CRON_SECRET=""

# Online rent payment via Flutterwave. Leave all three unset in dev — the
# "Pay Now" button then just tells the tenant online payment isn't set up
# yet, and the landlord's manual "Mark Paid" (cash/bank transfer) keeps
# working regardless. Get test keys from the Flutterwave dashboard
# (Settings > API) — use the "Test" keys while developing, "Live" only in
# production.
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
# Set the same value as your dashboard's Settings > Webhooks > "Secret Hash",
# and point that webhook at POST https://<your-domain>/api/webhooks/flutterwave.
FLW_SECRET_HASH=""
# Override only to point at a non-default Flutterwave API base URL (e.g. a sandbox host).
FLW_V3_BASE_URL="https://api.flutterwave.com/v3"

# --- Text messages (SMS) -------------------------------------------------
# Used for password reset codes, owner phone verification, and rent
# reminders. Leave unset and messages are only written to the server log —
# every flow still works, and reset codes are shown on screen outside
# production so you can test without paying for SMS credits.
# Set SMS_PROVIDER to "termii" or "africastalking", then the matching keys.
SMS_PROVIDER=""
TERMII_API_KEY=""
TERMII_SENDER_ID="Onile"
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""

# --- Where uploaded photos are stored ------------------------------------
# Leave these unset and photos are kept in the database, which works with
# no setup at all and is fine for a small launch. For anything busier,
# create a PUBLIC storage bucket in Supabase and set all three — new
# uploads then go there and are served from Supabase's CDN. Anything
# already stored in the database keeps working either way.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_STORAGE_BUCKET="onile-uploads"
